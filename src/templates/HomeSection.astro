---
// Home template, styled as a datasheet. Title block: the name as <h1> and the
// role line rendered from the section's markdown body. Then a "Specifications"
// table built from the typed `specs` frontmatter plus an "Elsewhere" row
// (GitHub/LinkedIn from frontmatter, About via sectionPath()), and the newest
// projects. Every link is registry- or frontmatter-derived, never a literal path.
// `description` is the meta description only and is not rendered.
// The only <script> is the JsonLdPerson data block.
import { render } from 'astro:content';
import { sectionPath, type SectionEntry } from '../config/sections';
import { getProjects, projectPath } from '../config/projects';
import JsonLdPerson from '../components/JsonLdPerson.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SpecTable from '../components/SpecTable.astro';

interface Props {
  entry: SectionEntry;
  sections: SectionEntry[];
}

const { entry, sections } = Astro.props;
const { Content } = await render(entry);

const { github, linkedin, specs = [] } = entry.data;
const aboutEntry = sections.find((s) => s.data.slug === 'about');
const projectsEntry = sections.find((s) => s.data.template === 'projects');

const recent = await Promise.all(
  (await getProjects()).slice(0, 3).map(async (project) => ({ project, href: await projectPath(project) })),
);
---

<JsonLdPerson />
<section class="hero">
  <h1>{entry.data.title}</h1>
  <div class="role">
    <Content />
  </div>
</section>

<section class="block" aria-labelledby="specs-heading">
  <div class="sechead">
    <h2 id="specs-heading">Specifications</h2>
  </div>
  <SpecTable rows={specs} caption="Specifications">
      <tr class="action">
        <th scope="row">Elsewhere</th>
        <td>
          <div class="links">
            {
              github && (
                <a href={github} target="_blank" rel="noopener noreferrer">
                  GitHub <span aria-hidden="true">↗</span>
                  <span class="visually-hidden"> (opens in new tab)</span>
                </a>
              )
            }
            {
              linkedin && (
                <a href={linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn <span aria-hidden="true">↗</span>
                  <span class="visually-hidden"> (opens in new tab)</span>
                </a>
              )
            }
            {
              aboutEntry && (
                <a href={sectionPath(aboutEntry)}>
                  About me <span aria-hidden="true">→</span>
                </a>
              )
            }
          </div>
        </td>
      </tr>
  </SpecTable>
</section>

{
  recent.length > 0 && (
    <section class="block" aria-labelledby="recent-heading">
      <div class="sechead">
        <h2 id="recent-heading">Recent projects</h2>
        {projectsEntry && (
          <a href={sectionPath(projectsEntry)}>
            All projects <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
      {recent.map(({ project, href }) => (
        <ProjectRow project={project} href={href} headingLevel="h3" compact />
      ))}
    </section>
  )
}

<style>
  .hero {
    padding-block: clamp(2rem, 6vh, 4rem) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 4vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    max-width: 9ch;
  }

  .role {
    font-size: var(--fs-lead);
    max-width: 34ch;
  }

  .role :global(p) {
    margin: 0;
  }

  .role :global(em) {
    font-style: normal;
    background: linear-gradient(transparent 62%, var(--color-highlight) 62%);
  }

  .block {
    margin-block-start: var(--space-5);
  }

  .sechead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    border-top: 1px solid var(--color-text);
    padding-top: 0.45rem;
  }

  .sechead h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sechead a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    min-height: var(--touch-min);
    margin-block: -0.6rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .links a {
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    min-height: var(--touch-min);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
