---
// Projects index template. Renders the section's markdown intro, then one
// ledger row per entry in the `projects` collection, grouped by year (newest
// first); see ProjectRow.astro. Adding a project is a new file in src/content/projects/ and
// nothing else. Zero client JS; images are optimized by astro:assets at build.
// Props contract: entry + full ordered registry.
import { render } from 'astro:content';
import { type SectionEntry } from '../config/sections';
import { getProjects, projectPath } from '../config/projects';
import ProjectRow from '../components/ProjectRow.astro';

interface Props {
  entry: SectionEntry;
  sections: SectionEntry[];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const projects = await Promise.all(
  (await getProjects()).map(async (project) => ({ project, href: await projectPath(project) })),
);

const years = Object.entries(
  Object.groupBy(projects, ({ project }) => String(project.data.date.getUTCFullYear())),
)
  .map(([year, items]) => ({ year, items: items ?? [] }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<section class="projects">
  <h1>{entry.data.title}</h1>
  <div class="intro">
    <Content />
  </div>
  {
    years.map(({ year, items }) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <div class="sechead">
          <h2 id={`year-${year}`}>{year}</h2>
          <span class="count">{items.length === 1 ? '1 entry' : `${items.length} entries`}</span>
        </div>
        {items.map(({ project, href }) => (
          <ProjectRow project={project} href={href} headingLevel="h3" />
        ))}
      </section>
    ))
  }
</section>

<style>
  .projects {
    padding-block: clamp(2rem, 6vh, 4rem) var(--space-7, 3rem);
  }

  .projects h1 {
    font-size: var(--fs-h2, clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem));
    line-height: var(--lh-h2, 1.2);
    margin-block-end: var(--space-5, 1.5rem);
  }

  .intro {
    max-width: var(--measure, 65ch);
  }

  .intro :global(p) {
    margin: 0;
  }

  .year {
    margin-block-start: var(--space-6);
  }

  .sechead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    border-top: 1px solid var(--color-text);
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sechead h2 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: inherit;
  }

  .count {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
