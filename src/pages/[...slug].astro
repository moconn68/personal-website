---
// Registry-driven route with template dispatch.
// One optional catch-all `[...slug]` generates one route per registered
// section: home → '/' (`params: { slug: undefined }`), others → '/{slug}/'
// (trailingSlash: 'always' — the canonical form shared by nav/canonical/
// sitemap). Template dispatch is glob-driven:
//   import.meta.glob('../templates/*.astro', { eager: true })
// keyed by templateToComponentName(template) (PascalCase + `Section` suffix).
// A registered section whose template component is missing FAILS the build —
// loud and typed; a registry pointing at nothing is a programming error, not
// a 404. A new section therefore needs zero changes to this file — the
// glob picks up new template components automatically.
// Every template receives entry + the full ordered registry (the template
// contract). No `path` prop to BaseLayout — Nav reads Astro.url.pathname itself.
import type { InferGetStaticPropsType } from 'astro';
import { getSections, sectionPath } from '../config/sections';
import { templateToComponentName } from '../config/templates';
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';

export async function getStaticPaths() {
  const entries = await getSections();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug === 'home' ? undefined : entry.data.slug },
    props: { entry },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const sections = await getSections();
const home = sections.find((section) => section.data.slug === 'home');
if (!home) throw new Error('Registry must contain a "home" section.');

// Title pattern: home → home.title; others →
// `{home.title} — {entry.data.title}` (mechanical off the registry).
const title = entry.data.slug === 'home' ? entry.data.title : `${home.data.title} — ${entry.data.title}`;
const currentPath = sectionPath(entry);

// Template dispatch via eager glob keyed by templateToComponentName(template).
// The `{ default: any }` cast is required — Astro's component
// factory type is not exposed via a public exports path. A registered section
// whose component is missing throws here → the build fails loudly.
// Note: every template's scoped CSS ships on every route. A lazy glob does
// NOT fix this — Astro's build CSS graph treats dynamic importers like static
// ones (verified on astro 7.3.3), so lazy imports produce identical output.
const templates = import.meta.glob('../templates/*.astro', { eager: true }) as Record<
  string,
  { default: any }
>;
const moduleKey = `../templates/${templateToComponentName(entry.data.template)}.astro`;
const Module = templates[moduleKey];
if (!Module) {
  throw new Error(`Missing template component for "${entry.data.template}" — expected ${moduleKey}.`);
}
const SectionTemplate = Module.default;
---

<BaseLayout>
  <Fragment slot="head">
    <Seo title={title} description={entry.data.description} path={currentPath} />
  </Fragment>
  <SectionTemplate entry={entry} sections={sections} />
</BaseLayout>