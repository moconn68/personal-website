---
// Custom 404 page, styled as a datasheet error-code entry. A fixed page — NOT
// a registry section, no error-template dispatch (the template enum has no
// `error` value). The mono "E404" line is decorative and aria-hidden; the h1
// stays "Page not found". Actions are registry-derived text links. Ships
// `<meta name="robots" content="noindex">` (excluded from the sitemap via the
// sitemap filter). Title/description here are self-contained. Zero client JS.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSections, sectionPath } from '../config/sections';

const sections = await getSections();
const home = sections.find((entry) => entry.data.slug === 'home');
if (!home) {
  throw new Error('Registry must contain a "home" section — the 404 "Back to home" link derives from it.');
}
const projects = sections.find((entry) => entry.data.template === 'projects');
---

<BaseLayout>
  <Fragment slot="head">
    <title>404 — Page not found</title>
    <meta name="description" content="This page does not exist. Return to the homepage." />
    <meta name="robots" content="noindex" />
  </Fragment>
  <section class="notfound">
    <p class="code" aria-hidden="true">E404 · page not found</p>
    <h1>Page not found</h1>
    <p class="message">The page you're looking for doesn't exist.</p>
    <p class="actions">
      <a href={sectionPath(home)}>Back to home <span aria-hidden="true">→</span></a>
      {
        projects && (
          <a href={sectionPath(projects)}>
            {projects.data.title} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: clamp(2rem, 6vh, 4rem) var(--space-7);
  }

  .code {
    margin: 0;
    align-self: stretch;
    border-top: 1px solid var(--color-text);
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .notfound h1 {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
  }

  .message {
    margin: 0;
    color: var(--color-muted);
  }

  .actions {
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    min-height: var(--touch-min);
    font-weight: 600;
  }
</style>
