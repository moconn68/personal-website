---
// Project detail route: one page per entry in the `projects` collection,
// rendered as a blog-style article at '/projects/{id}/'. Sits beside the
// registry-driven catch-all: `[...slug]` owns '/projects/' (the section
// index); this route owns everything beneath it. Same layout, Seo component,
// title pattern and trailing-slash policy as every other page.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Seo from '../../components/Seo.astro';
import SpecTable from '../../components/SpecTable.astro';
import { getSections, sectionPath } from '../../config/sections';
import { getProjects, projectPath } from '../../config/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const sections = await getSections();
const home = sections.find((s) => s.data.slug === 'home');
const index = sections.find((s) => s.data.template === 'projects');
if (!home || !index) throw new Error('Registry must contain "home" and a "projects" section.');

const title = `${home.data.title} — ${project.data.title}`;
const path = await projectPath(project);
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const published = project.data.date.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.ceil((project.body ?? '').split(/\s+/).filter(Boolean).length / 230));
const stack = project.data.tags.map((tag) => tag.toLowerCase()).join(' / ');
const liveUrl = project.data.liveUrl;
const liveHost = liveUrl ? new URL(liveUrl).hostname : undefined;
// Break the host only after dots: every segment but the last is followed by <wbr>.
const hostParts = liveHost ? liveHost.split('.') : [];
---

<BaseLayout>
  <Fragment slot="head">
    <Seo title={title} description={project.data.summary} path={path} type="article" />
  </Fragment>
  <article class:list={['post', { 'has-toc': toc.length > 0 }]}>
    <header class="head">
      <p class="crumb"><a href={sectionPath(index)}>&larr; {index.data.title}</a></p>
      <h1>{project.data.title}</h1>
      <p class="deck">{project.data.summary}</p>
      <SpecTable
        caption="Project details"
        rows={[
          { label: 'Published', value: published, datetime: published, suffix: `${minutes} min read`, mono: true },
          { label: 'Stack', value: stack, mono: true },
        ]}
      >
        {
          liveUrl && (
            <tr class="action">
              <th scope="row">Live</th>
              <td>
                <a class="live" href={liveUrl} target="_blank" rel="noopener noreferrer">
                  {hostParts.slice(0, -1).map((part) => (
                    <Fragment>
                      {part}.<wbr />
                    </Fragment>
                  ))}
                  <span class="nowrap">
                    {hostParts.at(-1)}&nbsp;<span aria-hidden="true">↗</span>
                  </span>
                  <span class="visually-hidden"> (opens in new tab)</span>
                </a>
              </td>
            </tr>
          )
        }
      </SpecTable>
    </header>
    <Image
      class="hero-img"
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 68.75rem) 47rem, (min-width: 48rem) 43rem, 100vw"
      loading="eager"
    />
    <div class="post-body">
      <Content />
    </div>
    {
      toc.length > 0 && (
        <aside class="toc" aria-label="Contents">
          <p class="toc-label">Contents</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2rem, 6vh, 4rem) var(--space-7);
  }

  .crumb {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: lowercase;
  }

  .post h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 3.5rem);
    line-height: 1;
  }

  .deck {
    margin: var(--space-3) 0 0;
    max-width: 48ch;
    font-size: 1.1875rem;
    color: var(--color-muted);
  }

  .head :global(.spec) {
    margin-block-start: var(--space-5);
    border-top: 1px solid var(--color-text);
  }

  .live {
    display: inline-block;
    padding-block: 0.4rem;
    min-height: var(--touch-min);
    font-weight: 600;
  }

  .nowrap {
    white-space: nowrap;
  }

  .post :global(.hero-img) {
    width: 100%;
    height: auto;
    margin-block: var(--space-6);
    border: 1px solid var(--color-border);
  }

  /* Prose: same measure, size and leading as the About article. */
  .post-body {
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    counter-reset: sec fig;
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-5);
  }

  .post-body :global(h2) {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    counter-increment: sec;
    scroll-margin-top: var(--space-5);
    font-size: var(--fs-h2);
    margin: var(--space-7) 0 var(--space-4);
  }

  .post-body :global(h2::before) {
    content: counter(sec);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    min-width: 1.25rem;
  }

  .post-body :global(h3),
  .post-body :global(h4) {
    scroll-margin-top: var(--space-5);
    margin: var(--space-6) 0 var(--space-3);
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .post-body :global(strong) {
    font-weight: 600;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    background: var(--color-rule-soft);
  }

  .post-body :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
  }

  /* Figures: an image alone in a paragraph, then an italic-only caption paragraph. */
  .post-body :global(p:has(> img)) {
    margin-block-end: var(--space-2);
    counter-increment: fig;
  }

  .post-body :global(p:has(> img) + p > em:only-child) {
    display: block;
    font-style: normal;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .post-body :global(p:has(> img) + p > em:only-child::before) {
    content: 'Fig. ' counter(fig) '  ';
    white-space: pre;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .toc {
    display: none;
  }

  /* Wide screens: column 1 stays exactly as wide as <main>; only the sticky
     contents aside hangs into the right margin. <main> is ~45.5rem and
     centred, so the 15rem aside needs a 80rem viewport to stay on screen. */
  @media (min-width: 80rem) {
    .post.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 12rem;
      column-gap: 3rem;
      margin-inline-end: calc(-1 * (12rem + 3rem));
      align-items: start;
    }

    .post.has-toc > :not(.toc) {
      grid-column: 1;
    }

    .toc {
      display: block;
      grid-column: 2;
      grid-row: 1 / span 3;
      position: sticky;
      top: var(--space-4);
      margin-block-start: var(--space-3);
      font-size: var(--fs-small);
    }

    .toc-label {
      margin: 0;
      padding-top: 0.45rem;
      border-top: 1px solid var(--color-text);
      font-family: var(--font-mono);
      font-size: var(--fs-small);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .toc ol {
      list-style: none;
      margin: var(--space-2) 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      counter-reset: t;
    }

    .toc li {
      display: flex;
      gap: var(--space-2);
      counter-increment: t;
    }

    .toc li::before {
      content: counter(t);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-muted);
      min-width: 1rem;
      padding-top: 0.1rem;
    }

    .toc a {
      text-decoration: none;
    }

    .toc a:hover {
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
