---
// Project detail route: one page per entry in the `projects` collection,
// rendered as a blog-style article at '/projects/{id}/'. Sits beside the
// registry-driven catch-all: `[...slug]` owns '/projects/' (the section
// index); this route owns everything beneath it. Same layout, Seo component,
// title pattern and trailing-slash policy as every other page. Zero client JS.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Seo from '../../components/Seo.astro';
import { getSections, sectionPath } from '../../config/sections';
import { getProjects, projectPath } from '../../config/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const sections = await getSections();
const home = sections.find((s) => s.data.slug === 'home');
const index = sections.find((s) => s.data.template === 'projects');
if (!home || !index) throw new Error('Registry must contain "home" and a "projects" section.');

const title = `${home.data.title} — ${project.data.title}`;
const path = await projectPath(project);
const { Content } = await render(project);
const published = project.data.date.toISOString().slice(0, 10);
const dateLabel = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout>
  <Fragment slot="head">
    <Seo title={title} description={project.data.summary} path={path} type="article" />
  </Fragment>
  <article class="post">
    <p class="crumb"><a href={sectionPath(index)}>&larr; {index.data.title}</a></p>
    <h1>{project.data.title}</h1>
    <p class="meta">
      <time datetime={published}>{dateLabel}</time>
    </p>
    <ul class="tags" aria-label="Technologies">
      {project.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {
      project.data.liveUrl && (
        <p class="cta">
          <a class="link-chip" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">
            Open {project.data.title}
            <span class="visually-hidden"> (opens in new tab)</span>
          </a>
        </p>
      )
    }
    <Image
      class="hero-img"
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 48rem) 43rem, 100vw"
      loading="eager"
    />
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2rem, 6vh, 4rem) var(--space-7, 3rem);
  }

  .crumb {
    margin: 0 0 var(--space-4, 1rem);
    font-size: var(--fs-small, 0.875rem);
  }

  .crumb a {
    color: var(--color-accent, #1e40af);
    text-underline-offset: 3px;
  }

  .post h1 {
    font-size: var(--fs-hero, clamp(2rem, 1.5rem + 2.6vw, 3.25rem));
    line-height: var(--lh-hero, 1.05);
  }

  .meta {
    margin: var(--space-2, 0.5rem) 0 var(--space-3, 0.75rem);
    font-size: var(--fs-small, 0.875rem);
    color: var(--color-muted, #52525b);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }

  .tags li {
    font-size: var(--fs-small, 0.875rem);
    color: var(--color-muted, #52525b);
    padding: var(--space-1, 0.25rem) var(--space-2, 0.5rem);
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: 999px;
  }

  .cta {
    margin: var(--space-4, 1rem) 0 0;
  }

  .link-chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min, 44px);
    min-width: var(--touch-min, 44px);
    padding-inline: var(--space-4, 1rem);
    font-weight: 600;
    color: var(--color-text, #18181b);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: 8px;
  }

  .link-chip:hover {
    color: var(--color-accent-hover, #172554);
    border-color: var(--color-accent, #1e40af);
    text-decoration-thickness: 2px;
  }

  .post :global(.hero-img) {
    width: 100%;
    height: auto;
    margin-block: var(--space-6, 2rem);
    border-radius: 8px;
  }

  /* Prose: same measure, size and leading as the About article. */
  .post-body {
    max-width: var(--measure, 65ch);
    font-size: var(--fs-body, 1rem);
    line-height: var(--lh-body, 1.6);
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-5, 1.5rem);
  }

  .post-body :global(h2) {
    font-size: var(--fs-h2, clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem));
    margin: var(--space-7, 3rem) 0 var(--space-4, 1rem);
  }

  .post-body :global(a) {
    color: var(--color-accent, #1e40af);
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: var(--color-accent-hover, #172554);
  }

  .post-body :global(strong) {
    font-weight: 600;
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    padding: 0.1em 0.3em;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e4e4e7);
    border-radius: 4px;
  }

  .post-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Figures: an image alone in a paragraph, then an italic-only caption paragraph. */
  .post-body :global(p:has(> img)) {
    margin-block-end: var(--space-2, 0.5rem);
  }

  .post-body :global(p:has(> img) + p > em:only-child) {
    display: block;
    font-style: normal;
    font-size: var(--fs-small, 0.875rem);
    color: var(--color-muted, #52525b);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
