---
// Registry-driven navigation. Every link, its label, and its order derive
// solely from the sections registry (src/config/sections.ts): getSections()
// returns entries sorted by `order` (home first), and sectionPath() is the
// single slug→URL mapping (home → '/', others → '/{slug}/' with trailing
// slash) — so nav hrefs are byte-identical with canonical/sitemap URLs.
// Zero hardcoded section paths: removing a registry entry removes its nav link.
// Zero client JS: no executable tags, no event-handler attributes, no style=
// attributes, no inline styles — all styling lives in the scoped block below.
import { getSections, sectionPath, type SectionEntry } from '../config/sections';

const sections: SectionEntry[] = await getSections();
const pathname = Astro.url.pathname;
---

<nav aria-label="Main">
  <ul>
    {
      sections.map((entry) => {
        const href = sectionPath(entry);
        const isActive = pathname === href;
        // Pages nested under a section (e.g. /projects/murmur/) mark their
        // parent section as the current location, not the current page.
        const isAncestor = !isActive && href !== '/' && pathname.startsWith(href);
        const current = isActive ? 'page' : isAncestor ? 'true' : undefined;
        // The home entry is the wordmark (site name); the rest are nav links.
        const isHome = entry.data.slug === 'home';
        return (
          <li class={isHome ? 'brand' : undefined}>
            <a href={href} aria-current={current} class={isHome ? 'mark' : undefined}>
              {isHome ? entry.data.title : entry.data.navLabel}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Datasheet header: condensed wordmark left, mono nav right, 2px ink rule
     beneath (the rule lives on <header> in BaseLayout). */
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-5);
  }

  li {
    margin: 0;
    padding: 0;
  }

  li.brand {
    margin-inline-end: auto; /* pushes remaining items to the right edge */
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--touch-min);
    min-width: var(--touch-min);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: lowercase;
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  a.mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.005em;
    text-transform: none;
  }

  /* LED indicator: hollow square normally, filled with a soft ring when
     aria-current is set. Weight 500 is the non-color cue. Wordmark has none. */
  a:not(.mark)::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--color-border);
  }

  a[aria-current]:not(.mark) {
    font-weight: 500;
  }

  a[aria-current]:not(.mark)::before {
    border-color: var(--color-led);
    background: var(--color-led);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-led) 25%, transparent);
  }

  /* Visible focus ring for keyboard and pointer input; never outline: none. */
  a:focus,
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
