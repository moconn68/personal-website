---
// ProfilePage JSON-LD data block — rendered at the TOP of the Résumé template
// body (inside <main>), NOT in <head> (same placement rationale). Facts come
// from the ONE shared module getPersonData() (no duplication); mainEntity
// references the Person node. `url` = the résumé page's absolute canonical URL
// via absoluteUrl('resume'). Data block, not client JS — the static-output gate
// must exempt type="application/ld+json".
import { getPersonData } from '../config/person';
import { absoluteUrl } from '../config/site';

const p = await getPersonData();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: `${p.name} — Résumé`,
  url: absoluteUrl('resume'),
  mainEntity: {
    '@type': 'Person',
    name: p.name,
    url: p.url,
    jobTitle: p.jobTitle,
    sameAs: p.sameAs.filter(Boolean),
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />