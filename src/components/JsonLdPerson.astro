---
// Person JSON-LD data block — rendered at the TOP of the Home template body
// (inside <main>), NOT in <head> (head-placement would force per-template wiring
// into the route). Crawlers parse JSON-LD anywhere in the document. is:inline
// guarantees Astro leaves the block untouched; set:html emits raw JSON, so every '<' is escaped to <
// to keep a script end tag in any string value from closing the block early.
// (Deliberately not spelling that end tag out literally in this comment —
// Vite's dependency scanner treats it as real markup even inside a comment.)
import { getPersonData } from '../config/person';
import { absoluteUrl } from '../config/site';

const p = await getPersonData();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  url: absoluteUrl('/'),
  jobTitle: p.jobTitle,
  sameAs: p.sameAs.filter(Boolean),
};
const json = JSON.stringify(ld).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
