---
// T-12: SEO head component (SEO-6/7/8/11). Composes into BaseLayout's
// `<slot name="head" />`: unique page <title>, ≤160-char meta description,
// Open Graph tags (og:title/og:description/og:type=website/og:url), and a
// self-referencing absolute canonical computed from SITE_URL (T-4). One
// canonical host — preview hosts emit cross-host canonicals pointing at the
// production site (correct; previews are additionally noindexed by T-18).
// Canonical href and og:url are byte-identical to the sitemap/robots URLs
// (single trailing-slash policy via `path()`/`absoluteUrl()` — R8, SEO-11).
// og:image is deliberately omitted (no stock imagery; HOME-4).
// The 404 page keeps static head content (not a registry section — no entry).
interface Props {
  title: string;
  description: string;
  /** Relative page path with trailing slash — sectionPath(entry), e.g. '/', '/resume/'. */
  path: string;
}

import { absoluteUrl } from '../config/site';

const { title, description, path } = Astro.props;
const url = absoluteUrl(path);
---

<Fragment>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <link rel="canonical" href={url} />
</Fragment>