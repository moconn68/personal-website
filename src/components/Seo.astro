---
// SEO head component. Composes into BaseLayout's `<slot name="head" />`:
// unique page <title>, ≤160-char meta description, Open Graph tags
// (og:title/og:description/og:type=website/og:url), and a self-referencing
// absolute canonical computed from SITE_URL. One canonical host — preview hosts
// emit cross-host canonicals pointing at the production site (correct; previews
// are additionally noindexed by the generated _headers rule). Canonical href
// and og:url are byte-identical to the sitemap/robots URLs (single
// trailing-slash policy via `path()`/`absoluteUrl()`).
// og:image is deliberately omitted (no stock imagery).
// The 404 page keeps static head content (not a registry section — no entry).
interface Props {
  title: string;
  description: string;
  /** Relative page path with trailing slash — sectionPath(entry), e.g. '/', '/about/'. */
  path: string;
}

import { absoluteUrl } from '../config/site';

const { title, description, path } = Astro.props;
const url = absoluteUrl(path);
---

<Fragment>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <link rel="canonical" href={url} />
</Fragment>