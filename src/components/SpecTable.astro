---
// Datasheet spec table: ink rule on top, hairline row dividers, mono muted
// labels. `rows` render as label/value pairs; `mono` sets the value in the mono
// face (data), and `datetime` wraps the value in a <time>. The default slot
// takes extra raw <tr> rows (e.g. a links row with class "action", whose cells
// are vertically centered to fit 44px tap targets).
interface Row {
  label: string;
  value: string;
  mono?: boolean;
  datetime?: string;
  suffix?: string;
}

interface Props {
  rows?: Row[];
  caption: string;
}

const { rows = [], caption } = Astro.props;
---

<table class="spec">
  <caption class="visually-hidden">{caption}</caption>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td class:list={{ mono: row.mono }}>
            {row.datetime ? <time datetime={row.datetime}>{row.value}</time> : row.value}
            {row.suffix && ` · ${row.suffix}`}
          </td>
        </tr>
      ))
    }
    <slot />
  </tbody>
</table>

<style>
  .spec {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: var(--space-1);
  }

  .spec :global(th),
  .spec :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }

  .spec :global(th) {
    width: 8.5rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-muted);
    padding-top: 0.7rem;
  }

  .spec td.mono {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding-top: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .spec :global(tr.action th),
  .spec :global(tr.action td) {
    vertical-align: middle;
    padding-block: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    .spec :global(th) {
      width: 6.5rem;
    }
  }
</style>
