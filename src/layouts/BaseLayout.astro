---
// Shared page chrome for every route. Semantic landmarks
// (<header>/<nav>/<main>/<footer>), a named head slot for per-route SEO
// content (filled by the Seo component), and a default body slot carrying the
// section template. The footer copyright name is read from the registry home
// entry — never hardcoded. Zero client JS: no executable script tags, no
// event-handler attributes, no style= attributes. Styling lives in the scoped
// block below plus src/assets/styles/global.css tokens.
// No `path` prop, no props to Nav — Nav reads Astro.url.pathname itself.
import Nav from '../components/Nav.astro';
import { getSections } from '../config/sections';
import '../assets/styles/global.css';
import { version } from '../../package.json';
// Hashed URLs via ?url match the @font-face url() in global.css exactly.
import font400 from '../assets/fonts/site-sans-400.woff2?url';
import fontDisplay700 from '../assets/fonts/site-display-700.woff2?url';

const sections = await getSections();
const home = sections.find((entry) => entry.data.slug === 'home');
if (!home) {
  throw new Error('Registry must contain a "home" section — the layout footer copyright derives from it.');
}
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preload only the above-the-fold faces: body sans and the display headings/wordmark. Mono and sans-600 load on demand. */}
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontDisplay700} as="font" type="font/woff2" crossorigin />
    {/* Per-route <title>/meta/canonical land here via the head slot (Seo). */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {/* Landmarks: <header> chrome, <nav> emitted by Nav.astro, <main id="main"> slot, <footer> */}
    <header>
      <Nav />
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>© {year} {home.data.title}</p>
      <p>Rev {version}</p>
    </footer>
  </body>
</html>

<style>
  /* Skip link: visually hidden first element in <body>,
     revealed on focus at the top-left of the viewport (WCAG 2.4.1). */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    z-index: 999;
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    color: var(--color-accent);
    font-weight: 600;
    border: 1px solid var(--color-border);
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    left: var(--gutter);
    top: var(--gutter);
  }

  /* Container constraint: centered, content width = --container minus gutters,
     so header/footer borders span exactly the content column. */
  header,
  main,
  footer {
    width: min(100% - 2 * var(--gutter), var(--container) - 2 * var(--gutter));
    margin-inline: auto;
  }

  header {
    border-bottom: 2px solid var(--color-text);
  }

  /* Footer: revision block, mono, muted, rule above; copyright left, revision right. */
  footer {
    margin-block-start: var(--space-7);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-3) var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  footer p {
    margin: 0;
  }
</style>