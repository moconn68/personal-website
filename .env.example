# Environment variables for the personal website (v1).
#
# NEVER commit a real `.env` file. `.env*` is gitignored except `.env.example`;
# this file is the only committed env artifact. If you need local overrides,
# copy this file to `.env` — and never commit that.

# PUBLIC_SITE_URL — the SINGLE source of truth for the canonical host.
# Defaults to https://www.mattoconn.workers.dev in src/config/site.ts and
# astro.config.mjs; every absolute URL (canonical, sitemap, robots.txt Sitemap
# line, JSON-LD) derives from it, as does the allowed origin checked by
# `npm run verify`. Astro injects PUBLIC_* vars from the environment at build
# time into import.meta.env.
#
# Optional: leaving it unset already yields the production host. Override it
# only to build against a different domain (e.g. a custom domain). Preview
# deploys should keep the production value so their canonicals still point at
# the production host; non-canonical hosts are kept out of search by a
# host-matched noindex rule in dist/_headers instead (scripts/gen-headers.mjs,
# derived from dist/robots.txt — no env var involved).
PUBLIC_SITE_URL=https://www.mattoconn.workers.dev

# Critical constraint: NEVER use a platform-injected host or branch variable
# as, or in place of, the site URL. Canonicals always target the production
# host PUBLIC_SITE_URL; non-canonical hosts get noindex instead.
