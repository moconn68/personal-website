# Environment variables for the personal website (v1).
#
# NEVER commit a real `.env` file. `.env*` is gitignored except `.env.example`;
# this file is the only committed env artifact. If you need local overrides,
# copy this file to `.env` — and never commit that.

# PUBLIC_SITE_URL — the SINGLE source of truth for the canonical host.
# Defaults to https://mattoconn.pages.dev in src/config/site.ts and
# astro.config.mjs; every absolute URL (canonical, sitemap, robots.txt Sitemap
# line, JSON-LD) derives from it, as does the allowed origin checked by
# `npm run verify`. Astro injects PUBLIC_* vars from the environment at build
# time into import.meta.env.
#
# Optional: leaving it unset already yields the production host. Override it
# only to build against a different domain (e.g. a custom domain). Preview
# deploys should keep the production value so their canonicals still point at
# the production host; they are kept out of search via CF_PAGES_BRANCH below.
PUBLIC_SITE_URL=https://mattoconn.pages.dev

# CF_PAGES_BRANCH — auto-provided by Cloudflare Pages on every build; do not
# set it in the Cloudflare dashboard. It alone decides the _headers output
# (the site URL plays no part). Documented for LOCAL preview-noindex simulation:
#   CF_PAGES_BRANCH=preview-x npm run build
# makes scripts/gen-headers.mjs emit the global `X-Robots-Tag: noindex` rule.
# Production semantics = unset (local builds) or `main` (the production branch).
CF_PAGES_BRANCH=main

# Critical constraint: NEVER use CF_PAGES_URL (Cloudflare's per-build preview
# host) as the site URL. Canonicals always target the production host
# PUBLIC_SITE_URL; previews get noindex from the CF_PAGES_BRANCH-driven
# _headers rule instead.
